{
  "apiVersion": "1.3",
  "description": "Camera-set metric: subscribe (client-at-connect order), register two cameras, enable across both, fused frames carry contributor attribution and hub-assigned seq.",
  "steps": [
    {
      "dir": "s2c",
      "msg": {
        "type": "hello",
        "apiVersion": "1.3",
        "hubVersion": "contract-test"
      }
    },
    {
      "dir": "c2s",
      "msg": {
        "method": "subscribe",
        "params": {
          "streams": [
            "landmarks",
            "progress",
            "event",
            "health"
          ]
        }
      }
    },
    {
      "dir": "s2c",
      "msg": {
        "reply": {
          "streams": [
            "landmarks",
            "progress",
            "event",
            "health"
          ]
        }
      }
    },
    {
      "dir": "c2s",
      "msg": {
        "method": "add_camera",
        "params": {
          "camera": {
            "cameraId": "front",
            "kind": "usb",
            "source": "v4l2:///dev/video0"
          }
        }
      }
    },
    {
      "dir": "s2c",
      "msg": {
        "reply": {
          "added": "front"
        }
      }
    },
    {
      "dir": "c2s",
      "msg": {
        "method": "add_camera",
        "params": {
          "camera": {
            "cameraId": "side",
            "kind": "usb",
            "source": "v4l2:///dev/video1"
          }
        }
      }
    },
    {
      "dir": "s2c",
      "msg": {
        "reply": {
          "added": "side"
        }
      }
    },
    {
      "dir": "c2s",
      "msg": {
        "method": "enable_metric",
        "params": {
          "metricId": "workout",
          "pluginId": "reps",
          "cameras": [
            "front",
            "side"
          ],
          "config": {
            "fusion": {
              "policy": "best",
              "scoreField": "visibility"
            }
          }
        }
      }
    },
    {
      "dir": "s2c",
      "msg": {
        "reply": {
          "enabled": "workout"
        }
      }
    },
    {
      "dir": "s2c",
      "msg": {
        "stream": "landmarks",
        "pluginId": "reps",
        "cameraId": "front",
        "seq": 1,
        "tsUs": 1000,
        "data": {
          "visibility": 0.9
        },
        "fused": true,
        "metricId": "workout"
      }
    }
  ]
}