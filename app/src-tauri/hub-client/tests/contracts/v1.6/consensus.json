{
  "apiVersion": "1.6",
  "description": "Versioned strict consensus: one durable event followed by authoritative progress. Camera registry and movement qualification are preconditions.",
  "steps": [
    {
      "dir": "s2c",
      "msg": {
        "type": "hello",
        "apiVersion": "1.6",
        "hubVersion": "contract-test"
      }
    },
    {
      "dir": "c2s",
      "msg": {
        "method": "subscribe",
        "params": {
          "streams": [
            "landmarks",
            "progress",
            "event",
            "health",
            "frame"
          ]
        }
      }
    },
    {
      "dir": "s2c",
      "msg": {
        "reply": {
          "streams": [
            "landmarks",
            "progress",
            "event",
            "health",
            "frame"
          ]
        }
      }
    },
    {
      "dir": "c2s",
      "msg": {
        "method": "enable_metric",
        "params": {
          "metricId": "workout",
          "pluginId": "reps_vision",
          "cameras": [
            "webcam",
            "phone"
          ],
          "config": {
            "movementId": "squat",
            "targetReps": 2,
            "sessionId": "session-1",
            "fusion": {
              "policy": "consensus",
              "quorum": 2
            }
          }
        }
      }
    },
    {
      "dir": "s2c",
      "msg": {
        "reply": {
          "enabled": "workout"
        }
      }
    },
    {
      "dir": "s2c",
      "msg": {
        "stream": "event",
        "pluginId": "reps_vision",
        "metricId": "workout",
        "cameraId": null,
        "seq": 2,
        "tsUs": 1000000,
        "data": {
          "movementId": "squat",
          "movementVersion": "squat-v1",
          "sessionId": "session-1",
          "detectionId": "run-1",
          "type": "rep_completed",
          "count": 1,
          "cameraIds": [
            "webcam",
            "phone"
          ]
        }
      }
    },
    {
      "dir": "s2c",
      "msg": {
        "stream": "progress",
        "pluginId": "reps_vision",
        "metricId": "workout",
        "cameraId": null,
        "seq": 3,
        "tsUs": 1000000,
        "data": {
          "movementId": "squat",
          "movementVersion": "squat-v1",
          "sessionId": "session-1",
          "detectionId": "run-1",
          "value": 1,
          "unit": "reps",
          "satisfied": false,
          "consensus": {
            "policy": "consensus",
            "quorum": 2,
            "state": "confirmed"
          }
        }
      }
    },
    {
      "dir": "c2s",
      "msg": {
        "method": "disable_metric",
        "params": {
          "metricId": "workout"
        }
      }
    },
    {
      "dir": "s2c",
      "msg": {
        "reply": {
          "disabled": "workout"
        }
      }
    }
  ]
}
